# Copy to .env (setup.sh does this for you) and fill in the values.
# .env is git-ignored - never commit it.

# Public hostname for the backend. setup.sh fills this with <your-ip>.sslip.io,
# a free hostname that points at your VM's IP (no domain purchase needed).
DOMAIN=

# Java heap. 768m is fine on the Ampere A1 shape; use 512m on the 1 GB E2.1.Micro shape.
JAVA_HEAP=768m

# --- Same secrets you had on Fly (Fly never shows their values, so re-enter them) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gmail address that sends the digest, and a Gmail *App Password* (not your login password):
# https://myaccount.google.com/apppasswords
JOBWATCH_EMAIL_FROM=
SPRING_MAIL_PASSWORD=
# Where the digest is delivered.
JOBWATCH_EMAIL_TO=

# Optional healthchecks.io ping URL (alerts you if the 6 AM run fails or never happens).
HEALTHCHECK_URL=

# Daily digest schedule (Spring cron: sec min hour day month weekday) and its time zone.
JOBWATCH_CRON=0 0 6 * * *
JOBWATCH_CRON_ZONE=Asia/Kolkata

# --- Backups (backup.sh runs daily at 02:00 India time) ---
# How many daily copies to keep on the server.
BACKUP_KEEP=7
# Optional off-site copy: an Oracle Object Storage pre-authenticated request URL (ending in /o/)
# with "Permit object writes". Leave empty to keep backups on the server only.
BACKUP_UPLOAD_URL=
